<style>
    :root {
        --modal-ust-red: #800020;
        --modal-ust-red-dark: #5a0016;
    }

    #change_image_modal .modal-header {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0 !important;
        padding: 16px 20px;
    }

    #change_image_modal .modal-title {
        color: var(--modal-ust-red);
        font-size: 1.1rem;
    }

    .modal-avatar-preview-wrapper {
        position: relative;
        display: inline-block;
        margin: 10px auto;
    }

    .modal-avatar-img {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: transform 0.2s ease;
    }

    .dropzone-upload-box {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 18px 12px;
        background-color: #f8fafc;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .dropzone-upload-box:hover, .dropzone-upload-box.dragover {
            border-color: var(--modal-ust-red);
            background-color: rgba(128, 0, 32, 0.04);
        }

    .dropzone-icon {
        font-size: 1.8rem;
        color: var(--modal-ust-red);
        margin-bottom: 6px;
    }

    .dropzone-text-main {
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
        margin: 0;
    }

    .dropzone-text-sub {
        font-size: 0.72rem;
        color: #64748b;
        margin-top: 2px;
    }

    .file-info-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #edf2f7;
        color: #2d3748;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        margin-top: 8px;
    }

    .btn-update-photo {
        background-color: var(--modal-ust-red);
        color: #ffffff;
        font-weight: 700;
        border-radius: 8px;
        padding: 8px 20px;
        border: none;
    }

        .btn-update-photo:hover, .btn-update-photo:active {
            background-color: var(--modal-ust-red-dark);
            color: #ffffff;
        }
</style>

<div class="modal fade" id="change_image_modal" tabindex="-1" aria-labelledby="changeImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm-custom" style="max-width: 420px;">
        <div class="modal-content rounded-4 shadow-lg border-0 overflow-hidden">

            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="changeImageModalLabel">
                    <i class="fa-solid fa-camera me-1"></i> Change Profile Picture
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 text-center">

                <div class="modal-avatar-preview-wrapper mb-3">
                    <img src="~/AlumniImages/@(Model.Guid).JPEG"
                         alt="Current Profile"
                         id="preview-profile-image"
                         class="modal-avatar-img"
                         onerror="this.src='/AlumniImages/0.JPEG'" />
                </div>

                <div class="dropzone-upload-box" id="dropzone-trigger">
                    <div class="dropzone-icon">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <p class="dropzone-text-main">Click or drag an image here to upload</p>
                    <span class="dropzone-text-sub">Supports JPG, JPEG, PNG (Max 5MB)</span>
                    <input type="file"
                           id="change_profile_Attachment"
                           name="change_profile_Attachment"
                           accept="image/jpeg, image/jpg, image/png"
                           hidden>
                </div>

                <div id="selected-file-container" style="display: none;">
                    <span class="file-info-badge">
                        <i class="fa-solid fa-file-image text-danger"></i>
                        <span id="selected-filename-text">image.jpg</span>
                    </span>
                </div>

                <div class="progress mt-3" style="height: 6px; display: none;" id="upload-progress-container">
                    <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" role="progressbar" id="upload-progress-bar" style="width: 0%;"></div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0 pb-3 px-4 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
                <button type="button" class="btn btn-update-photo" id="save-picture-button">
                    <i class="fa-regular fa-circle-check me-1"></i> Update Photo
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const fileInput = document.getElementById("change_profile_Attachment");
        const dropzone = document.getElementById("dropzone-trigger");
        const previewImg = document.getElementById("preview-profile-image");
        const fileContainer = document.getElementById("selected-file-container");
        const fileNameText = document.getElementById("selected-filename-text");

        if (dropzone && fileInput) {
            dropzone.addEventListener("click", () => fileInput.click());
            
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.classList.remove('dragover');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    fileInput.files = files;
                    handleFileSelect(files[0]);
                }
            });
            
            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    handleFileSelect(this.files[0]);
                }
            });

            function handleFileSelect(file) {
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                    
                    if (fileNameText && fileContainer) {
                        fileNameText.innerText = file.name;
                        fileContainer.style.display = "block";
                    }
                }
            }
        }
    });
</script>