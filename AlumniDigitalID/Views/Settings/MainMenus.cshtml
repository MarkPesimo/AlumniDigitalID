@model List < ZMGModel.ViewModel.ALUMNI.Alumni_Model + Menu_model >

<style>
    .menu-grid {
        margin: 0;
        height: 100%;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
    }

    .menu-tile-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: clamp(8px, 1.6vh, 14px) 8px;
        text-align: center;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        height: 100%;
        box-sizing: border-box;
    }

        .menu-tile-card:hover, .menu-tile-card:active {
            background-color: #fdfbfb;
            border-color: rgba(128, 0, 32, 0.3);
            box-shadow: 0 4px 10px rgba(128, 0, 32, 0.1);
        }

    .menu-icon-wrapper {
        width: clamp(32px, 4.5vh, 42px);
        height: clamp(32px, 4.5vh, 42px);
        border-radius: 10px;
        background: rgba(128, 0, 32, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: clamp(4px, 1vh, 8px);
    }

        .menu-icon-wrapper i {
            font-size: clamp(1rem, 2vh, 1.25rem);
            color: #800020;
        }

    .menu-title {
        font-weight: 700;
        font-size: clamp(0.65rem, 1.2vh, 0.75rem);
        color: #2c2c2c;
        letter-spacing: 0.2px;
        text-transform: uppercase;
        margin: 0;
        line-height: 1.1;
    }
</style>

<div class="row g-2 menu-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var m in Model)
        {
            <div class="col-6">
                <a href="@Url.Action(m.MenuAction, m.MenuController)" class="menu-tile-card">
                    <div class="menu-icon-wrapper">
                        <i class="@m.MenuIcon"></i>
                    </div>
                    <div class="menu-title">@m.MenuTitle</div>
                </a>
            </div>
        }
    }
</div>