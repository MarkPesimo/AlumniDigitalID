@model  List<ZMGModel.ViewModel.ALUMNI.Alumni_Model.Menu_model>


<div class="row text-center mt-4 g-3">
    @foreach (var m in Model)
    {
        <div class="col-6 col-md-3 col-lg-3">
            <a href="@Url.Action(m.MenuAction, m.MenuController)" class="text-decoration-none">
                <div class="tile rounded py-3 shadow-sm">
                    <i class="@m.MenuIcon fs-1 icon-color"></i>
                    <div class="fw-bold mt-2">@m.MenuTitle</div>
                </div>
            </a>
        </div>

 
    }
     
</div>