<style>
    :root {
        --ust-red: #800020;
        --ust-red-dark: #5a0016;
        --ust-gold: #ffc72c;
    }

    #edit_perks_modal .modal-dialog {
        max-width: 92% !important;
        width: 620px;
        margin: 1.25rem auto;
    }

    @@media (min-width: 768px) {
        #edit_perks_modal .modal-dialog {
            max-width: 620px !important;
        }
    }

    #edit_perks_modal .modal-content {
        border-radius: 18px !important;
        overflow: hidden;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        max-height: 88vh;
        display: flex;
        flex-direction: column;
    }

    #edit_perks_modal .modal-header-ust {
        background: linear-gradient(135deg, var(--ust-red) 0%, var(--ust-red-dark) 100%);
        color: #ffffff;
        padding: 14px 20px;
        border-bottom: 2px solid var(--ust-gold);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    #edit_perks_modal .modal-title {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.3px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    #edit_perks_modal .modal-title i {
        color: var(--ust-gold);
    }

    #edit_perks_modal .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background-color: #ffffff;
    }

    #edit_perks_modal .form-label,
    #edit_perks_modal label {
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        color: #444444;
        margin-bottom: 3px !important;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    #edit_perks_modal .form-control,
    #edit_perks_modal .form-select {
        border-radius: 8px !important;
        font-size: 0.82rem !important;
        padding: 7px 10px !important;
        border: 1px solid #dcdcdc;
        background-color: #fafafa;
    }

    #edit_perks_modal .form-control:focus,
    #edit_perks_modal .form-select:focus {
        border-color: var(--ust-red) !important;
        box-shadow: 0 0 0 0.2rem rgba(128, 0, 32, 0.12) !important;
        background-color: #ffffff;
    }

    #edit_perks_modal .file-size-note {
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--ust-red);
        margin-bottom: 4px;
        display: block;
    }

    #edit_perks_modal .modal-footer-ust {
        background-color: #f8f9fa;
        padding: 12px 20px;
        border-top: 1px solid #eeeeee;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
    }

    #edit_perks_modal .btn-cancel {
        background-color: #e2e6ea;
        color: #333333;
        border: none;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 8px 18px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    #edit_perks_modal .btn-cancel:hover {
        background-color: #d3d9df;
        color: #111111;
    }

    #edit_perks_modal .btn-save {
        background-color: var(--ust-red);
        color: #ffffff;
        border: none;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 8px 22px;
        border-radius: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(128, 0, 32, 0.25);
    }

    #edit_perks_modal .btn-save:hover {
        background-color: var(--ust-red-dark);
        color: #ffffff;
    }
</style>

<div class="modal fade" id="edit_perks_modal" tabindex="-1" aria-labelledby="jobOrderLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header-ust">
                <h5 class="modal-title" id="jobOrderLabel">
                    <i class="fas fa-gift"></i> Edit Perks
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
            </div>

            <div class="modal-footer-ust">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-save" id="update-perks-button">
                    <i class="fas fa-check-circle me-1"></i> Update
                </button>
            </div>

        </div>
    </div>
</div>