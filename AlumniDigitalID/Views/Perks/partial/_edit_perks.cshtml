@model ZMGModel.ViewModel.ALUMNI.Alumni_Model.Perk_model.PerkInfo_model

@using (Html.BeginForm("_Edit", "Perks", FormMethod.Post, new { enctype = "multipart/form-data", name = "edit-perks-form", id = "edit-perks-form", @class = "mb-0" }))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Mode)
    @Html.HiddenFor(m => m.DateCreated)
    @Html.HiddenFor(m => m.FileType)
    @Html.HiddenFor(m => m.SchoolId)
    @Html.HiddenFor(m => m.CourseId)
    @Html.HiddenFor(m => m.Guid)
    @Html.HiddenFor(m => m.UserId)
    @Html.HiddenFor(m => m.AlumniGroupId)

    <div class="row" id="div-validation" style="display: none;">
        <div class="col mb-2">
            <label for="html" id="error-message-label" class="form-label text-danger"></label>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-12">
            <div class="form-group mb-2">
                <label for="Title" class="form-label">Title</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-12">
            <div class="form-group mb-2">
                <label for="Description" class="form-label">Description</label>
                @Html.TextAreaFor(m => m.Description, 4, 40, new { @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="row g-2 mb-0">
        <div class="col-12">
            <div class="form-group mb-0">
                <label for="edit_perks_Attachment" class="form-label">Attachment</label>
                <span class="file-size-note">* Please limit the attachment file size to 3MB.</span>
                <input class="form-control" type="file" name="edit_perks_Attachment" id="edit_perks_Attachment">
            </div>
        </div>
    </div>
}