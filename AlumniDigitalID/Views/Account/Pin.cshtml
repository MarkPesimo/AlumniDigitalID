@model ZMGModel.ViewModel.ALUMNI.Alumni_Model.User_model.Pin_model

@{
    ViewBag.Title = "Digital ID Authentication";
    Layout = "~/Views/Shared/Layout/_BlankLayout.cshtml";
}

@section Scripts
{
    <script src="~/Scripts/User/Pin.js"></script>
    <script>
        function togglePinVisibility() {
            var pinInput = document.getElementById("PinNumber");
            var toggleIcon = document.getElementById("togglePinIcon");
            if (pinInput.type === "password") {
                pinInput.type = "text";
                toggleIcon.classList.remove("fa-eye");
                toggleIcon.classList.add("fa-eye-slash");
            } else {
                pinInput.type = "password";
                toggleIcon.classList.remove("fa-eye-slash");
                toggleIcon.classList.add("fa-eye");
            }
        }
    </script>
}

<style>
    :root {
        --ust-red: #800020;
        --ust-red-dark: #5a0016;
        --ust-gold: #ffc72c;
    }

    html, body {
        height: 100dvh;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: radial-gradient(circle at top, #f8f9fa 0%, #e9ecef 100%);
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    .auth-screen-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100dvh;
        padding: 16px;
        box-sizing: border-box;
    }

    .auth-app-container {
        width: 100%;
        max-width: 380px;
        background-color: #ffffff;
        border-radius: 22px;
        padding: 28px 22px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .brand-logo-wrapper {
        position: relative;
        margin-bottom: 12px;
    }

    .brand-logo {
        height: 64px;
        width: auto;
        object-fit: contain;
    }

    .brand-name {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--ust-red);
        margin-bottom: 2px;
        letter-spacing: 0.3px;
    }

    .auth-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background-color: rgba(128, 0, 32, 0.08);
        color: var(--ust-red);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 3px 10px;
        border-radius: 10px;
        margin-top: 4px;
    }

        .auth-badge i {
            color: var(--ust-red);
        }

    .pin-form-container {
        width: 100%;
        margin-top: 20px;
    }

    .pin-instruction {
        font-size: 0.82rem;
        font-weight: 700;
        color: #444444;
        margin-bottom: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .pin-input-group {
        border-radius: 12px !important;
        overflow: hidden;
        border: 1px solid #dcdcdc;
        transition: all 0.2s ease;
        background-color: #fafafa;
    }

        .pin-input-group:focus-within {
            border-color: var(--ust-red) !important;
            box-shadow: 0 0 0 0.2rem rgba(128, 0, 32, 0.12) !important;
            background-color: #ffffff;
        }

    .pin-input-icon {
        background: transparent;
        border: none;
        color: var(--ust-red);
        padding-left: 14px;
    }

    .pin-field {
        border: none !important;
        font-size: 1.35rem !important;
        font-weight: 700;
        letter-spacing: 12px;
        color: #222222;
        padding: 10px 0 !important;
        box-shadow: none !important;
        background: transparent !important;
    }

        .pin-field::placeholder {
            letter-spacing: normal;
            font-size: 0.85rem;
            font-weight: 400;
            color: #aaaaaa;
        }

    .pin-toggle-btn {
        background: transparent;
        border: none;
        color: #888888;
        padding-right: 14px;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .pin-toggle-btn:hover {
            color: var(--ust-red);
        }

    .btn-authenticate {
        background: linear-gradient(135deg, var(--ust-red) 0%, var(--ust-red-dark) 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.88rem;
        border: none;
        border-radius: 12px;
        padding: 12px;
        width: 100%;
        margin-top: 16px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(128, 0, 32, 0.25);
    }

        .btn-authenticate:hover {
            background: var(--ust-red-dark);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(128, 0, 32, 0.3);
        }

    .security-note {
        font-size: 0.7rem;
        color: #888888;
        margin-top: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
</style>

<div class="auth-screen-wrapper">
    <div class="auth-app-container">

        <div class="brand-logo-wrapper">
            <img src="~/Content/images/@Model.AlumniLogo" alt="Alumni Logo" class="brand-logo" onerror="this.style.display='none'" />
        </div>

        <div class="brand-name">@Model.AlumniName</div>

        <span class="auth-badge">
            <i class="fa-solid fa-fingerprint me-1"></i> Digital ID Authentication
        </span>

        <div class="pin-form-container">
            @using (Html.BeginForm("Pin", "User", FormMethod.Post, new { id = "pin-form", name = "pin-form" }))
            {
                @Html.HiddenFor(m => m.GuidId)
                @Html.HiddenFor(m => m.SchoolId)

                <div class="pin-instruction">Enter Access PIN</div>
                
                <div class="row" id="div-validation" style="display: none;">
                    <div class="col-12 mb-2">
                        <label id="error-message-label" class="form-label text-danger small font-weight-bold mb-0"></label>
                    </div>
                </div>

                @Html.ValidationMessageFor(model => model.PinNumber, null, new { @class = "small text-danger d-block mb-2" })
                
                <div class="input-group pin-input-group">
                    <span class="input-group-text pin-input-icon">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    @Html.PasswordFor(m => m.PinNumber, new {
                        @class = "form-control pin-field text-center",
                        @placeholder = "••••",
                        @maxlength = "6",
                        @autocomplete = "off"
                    })

                    <button type="button" class="pin-toggle-btn" onclick="togglePinVisibility()" title="Toggle PIN visibility">
                        <i class="fa-solid fa-eye" id="togglePinIcon"></i>
                    </button>
                </div>

                <button type="submit" class="btn btn-authenticate" id="authenticate-btn">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Login
                </button>
            }
        </div>

        <div class="security-note">
            <i class="fa-solid fa-shield-halved"></i> Secured Alumni Portal Access
        </div>

    </div>
</div>