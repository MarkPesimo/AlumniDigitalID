@model  ZMGModel.ViewModel.ALUMNI.Alumni_Model.User_model.Renew_model

@{
    ViewBag.Title = "DigitalId Membership Renewal";
    Layout = "~/Views/Shared/Layout/_Layout2.cshtml";
}


@section Scripts
{
    <script src="~/Scripts/Alumni/Renew.js"></script>
}


<style>
    body {
        background-color: #edd2b7;
    }

    .login-container {
        width: 100%;
        max-width: 350px;
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .form-control::placeholder {
        font-style: italic;
    }

    .pin-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: darkred;
        display: inline-block;
        margin: 0 6px;
    }
</style>

<div class="d-flex flex-column justify-content-center align-items-center vh-100">
    <div class="login-container text-center">
        <h5 class="mb-4">
            <strong><i class="bi bi-person me-2"></i>MEMBERSHIP RENEWAL</strong>
        </h5>


        @using (Html.BeginForm("Renew", "Account", FormMethod.Post, new { id = "membershiprenewal-Form" }))
        {
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.AlumniGroupId)
            @Html.HiddenFor(m => m.AlumniNo)
            @Html.HiddenFor(m => m.MembersName)
            @Html.HiddenFor(m => m.MemberGUID)
            @Html.HiddenFor(m => m.RenewType)


            <div class="row" id="div-validation" style="display: none;">
                <div class="col-lg-12 mb-3">
                    <label for="html" id="error-message-label" class="form-label text-danger"></label><br>
                </div>
            </div>

            <div class="alert alert-danger d-none" id="div-validation">
                <label id="error-message-label" class="mb-0"></label>
            </div>

            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.AlumniNo, new { @class = "font-weight-bold" })
                        @Html.TextBoxFor(m => m.AlumniNo, new { @class = "form-control bg-secondary text-center text-white", @readonly = "readonly" })
                    </div>
                </div>

                <div class="col-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.RenewType, new { @class = "font-weight-bold" })
                        @Html.TextBoxFor(m => m.RenewType, new { @class = "form-control bg-secondary text-center text-white", @readonly = "readonly" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MembershipExpiration, new { @class = "font-weight-bold" })
                        @Html.TextBoxFor(m => m.MembershipExpiration, new { @class = "form-control bg-secondary text-center text-white", @readonly = "readonly" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MembersName, new { @class = "font-weight-bold" })
                        @Html.TextBoxFor(m => m.MembersName, new { @class = "form-control bg-secondary text-center text-white", @readonly = "readonly" })
                    </div>
                </div>
            </div>


            <div class="row mt-3">
                <div class="col">
                    <div class="form-group">
                        <label for="" class="font-weight-bold">Attach proof of payment</label>
                        <input class="form-control" type="file" name="Payment_Attachment" id="Payment_Attachment">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 mt-4" id="submit-renewal-btn">Submit</button>
        }

    </div>
</div>
